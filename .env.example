# Sentinel API & MCP Security Gateway Configuration
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Authentication & JWT
JWT_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting
RATE_LIMIT_DEFAULT_REQUESTS=60
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60

# MCP Security Controls
MCP_ENFORCE_TOOL_SCOPING=true
MCP_BLOCK_PROMPT_INJECTION=true
MCP_REQUIRE_APPROVAL_FOR_ELEVATED=true
MCP_MAX_SAMPLING_TOKENS=2048

# Payload Inspection Limits
MAX_PAYLOAD_SIZE_BYTES=10485760
BLOCK_SQLI=true
BLOCK_COMMAND_INJECTION=true
BLOCK_PATH_TRAVERSAL=true

# Data Redaction
REDACT_SENSITIVE_DATA=true
